//第一趟角度更大了避免碰撞，不用回去骚扰第二行了，希望直接能拿下1+2+2，即只留第一行首尾两个给对手
//重启一：1.短按近端3个再扫  2.长按远端3个再扫      (按计划进行则需短按)
//重启二：1.短按远端2个再扫  2.长按近端2个再扫      (按计划进行则需短按)

#include "motor.h"
#include "balance.h"
void motorgo666(int a,int b,int c,int d,float time);  //连贯动作，不延时
void motor666(int a,int b,int c,int d,float time);    //为了保护电机，这是很必要的
void delay_ms00(uint32_t ms);  //延时函数
void init();  //所有元件初始化

int main(void){
    init();
					motor666(-8900,-11000,11000,9800,0.079);       
					motorgo666(11500,11500,13000,13000,2.1);      //前进    
					motorgo666(3000,3000,14000,13000,0.58);      //丝滑逆70度
		      motorgo666(11500,11500,13000,13000,0.37);    //大前进    
					motorgo666(3000,3000,13300,12000,0.42);     //丝滑逆45
          motor666(11000,11000,12000,12000,1.41);
		
		      motor666(-11000,-11000,-12000,-12000,1.64);
	        motor666(10000,13300,-13500,-9800,0.4);		
          motor666(-8900,-8900,-10000,-10000,1.3);
		
		      motor666(-10000,-11000,12500,9800,0.6);
		      motor666(8900,8900,10000,10000,0.77);
					motor666(10000,13300,-13500,-9800,0.62);
          motorgo666(11000,11000,12000,12000,0.6);
		      motorgo666(3000,3000,12500,12000,0.35);     //丝滑逆45
          motor666(11000,11000,12000,12000,2);					

    
		while(1){	 //第一次重启
				if(click()==1){
					delay_ms00(33898*2);
					motor666(8900,8900,10000,10000,0.58);      
					motor666(10000,13300,-13500,-9800,0.66);
					motor666(8900,8900,10000,10000,0.9);     
					motor666(5000,5000,6000,6000,0.7);
					motor666(-10000,-11000,12500,9800,0.79);  
					motorgo666(8900,8900,10000,10000,0.9);     
					motorgo666(12500,13000,3000,3000,0.3);     
					motor666(8900,8900,10000,10000,4);     					

					break;}}


    while(1){	 //第二次重启
			if(click()==1){
				delay_ms00(33898*0.5);
				if(click()==1){  //长按0.5秒远端2个
					delay_ms00(33898*2);
					motor666(-8900,-11000,11000,9800,0.079);       
					motorgo666(11500,11500,13000,13000,1.7);      //前进    
					motorgo666(3000,3000,14000,13000,0.58);      //丝滑逆70度
          motorgo666(11000,11000,12000,12000,0.4);
		      motorgo666(3000,3000,12500,12000,0.25);     //丝滑
					motor666(8900,8900,10000,10000,3);      
					

					break;}
				else{      //短按捞
					delay_ms00(33898*1);
					motor666(-8900,-11000,11000,9800,0.079);       
					motorgo666(11500,11500,13000,13000,1.7);      //前进    
					motorgo666(3000,3000,14000,13000,0.58);      //丝滑逆70度
		      motorgo666(11500,11500,13000,13000,0.57);    //大前进    
					motorgo666(3000,3000,13300,12000,0.42);     //丝滑逆45
          motor666(11000,11000,12000,12000,1.25);
          break;}}}
}

