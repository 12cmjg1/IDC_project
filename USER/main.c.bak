				  motor666(8900,8900,10000,10000,2.7);      
				  motor666(10000,13300,-13500,-9800,0.795);       
				  motorgo666(8900,8900,10000,10000,0.8);  
				  motor666(6000,6000,7000,7000,0.5);  
          motor666(-7000,-7000,-8000,-8000,0.152);
				  motor666(10000,13300,-13500,-9800,0.78);       
				  motor666(8900,8900,10000,10000,0.9);
				  motor666(10000,13300,-13500,-9800,0.8);       
				  motor666(8900,8900,10000,10000,0.5);      				
											
				  delay_ms00(33898*1);
				  motorgo666(8900,8900,10000,10000,0.58);  				
				  motorgo666(3000,3000,14000,13000,0.25);
				  motorgo666(8900,8900,10000,10000,0.8);
				  motorgo666(12500,13000,3000,3000,0.55);
				  motor666(8900,8900,10000,10000,4);      
*/
/*
		motor666(8900,8900,10000,10000,0.63);
		motor666(10000,13300,-13500,-10000,0.65);
		motorgo666(8900,8900,10000,10000,0.35);
		motorgo666(3000,3000,14000,13000,0.8);     //丝滑逆45
		motorgo666(8900,8900,10000,10000,0.2);
		motorgo666(3000,3000,14000,13000,0.7);     //丝滑逆45
		motor666(8900,8900,10000,10000,1.8);       //丝滑逆45
*/
void motor666(int a,int b,int c,int d,float time){
    Set_Pwm(a, -1*b, -1*c, d, 0);
		delay_ms00(33898*time);
		Set_Pwm(0, 0,0, 0, 0);	
		delay_ms00(33898*0.2);
}

void motorgo666(int a,int b,int c,int d,float time){
    Set_Pwm(a, -1*b, -1*c, d, 0);
		delay_ms00(33898*time);
}

void init(){
		V1_1_LED_Init();
		V1_1_LED = 1;  //关闭可爱蓝色小灯
		Buzzer_Init();
		KEY_Init();
    Enable_Pin();
    TIM1_PWM_Init(16799, 83); 
    TIM9_PWM_Init(16799, 83); 
    TIM10_PWM_Init(16799, 83);
    TIM11_PWM_Init(16799, 83);
		TIM12_SERVO_Init(20000, 84);
}

void delay_ms00(uint32_t ms) {
    for (uint32_t i = 0; i < ms * 1000; i++) {
        __asm("nop");
    }
}